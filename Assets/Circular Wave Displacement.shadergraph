    },
    "m_SourceType": 1,
    "m_FunctionName": "CalculateArenaMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 arenaCenter = float3(CenterVec.x, 0.0, CenterVec.z);\nfloat d = distance(float3(WorldPos.x, 0.0, WorldPos.z), arenaCenter);\nMask = 1.0 - step(Radius, d);"
}

