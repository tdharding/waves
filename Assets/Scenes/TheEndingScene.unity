  m_Script: {fileID: 11500000, guid: 4f38ddd1a6ccc61418db8986d2f59978, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SoulEndingText
  endingText: {fileID: 1472722587}
  openingLine: You have finished the game...
  noSoulsMessage: You rescued no souls...
  baseMessageFormat: You rescued {0} soul{1}.
  remark_1_to_5: "Every soul counts and you rescued a few... many were left behind
    but at what cost? \nIt certainly wasn't easy..."
  remark_6_to_10: Half a boat load... Such courage in the face of tumultuous waves...
    These souls will live their days in appreciation of your deeds
  remark_11_to_19: A boat full of souls now have escaped this wretched game... they
    go on to prosperous and kindly activities all throughout the realm.... they remember
    you and your boat...
  remark_20_plus: 'Incredible... I didn''t know it was possible...! You navigated
    the tretcherous waves of this cruel test of courage and perserverance... the
    souls will sing a hymn to the Angel of Nom Kabar in your memory... '
  finalLine: 'What other adventures await in the lands of Nom Kabar...?


    Thankyou
    for Playing.'
