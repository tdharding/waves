--- !u!114 &1558289100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1558289096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4e7d21b270e2c94886c304eb2b1fb1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSequenceNotes
  purpose: 'This component documents the full Intro boat cutscene flow.

    It exists
    only for memory, clarity, and future refactoring.

    Safe to remove at any
    time.'
  sequenceBlocks:
  - thumbnail: {fileID: 0}
    title: Declarations
    description: 'Gameplay controls are disabled.

      Gameplay boat is hidden.

      Intro
      cameras are initialised.

      Wave plane is enabled.

      UI is hidden
      (except Skip UI).

      Wave material is set to IntroCam1 state.

'
  - thumbnail: {fileID: 2800000, guid: 6e5f217086138b046a281c4735582a05, type: 3}
    title: IntroCam1
    description: "IntroCam1 plays as a moving establishing shot.\n\nUses script IntroCam1AnimationRelay
      to signal transition \"OnIntroCam1Finish();\"\n\nOnIntroCam1Finish:\n\r\n\u2022
      Cutscene boat is enabled.\r\n\u2022 Transition to IntroCam2 occurs.\r\n\u2022
      Wave material switches to IntroCam2 state.\r\n"
  - thumbnail: {fileID: 2800000, guid: abebdc0676c29694bb19cc88acedaa2d, type: 3}
    title: IntroCam2
    description: "Cutscene boat begins moving.\n\nCutsceneboat has animator & script
      \"CutSceneBoatNotifier\"\n\nCutSceneBoat cues IntroCam3 when it reaches a point
      in the animation\n\nReachedIntroWayPointB()\r\n  "
  - thumbnail: {fileID: 2800000, guid: 4e5d9da075b265540870114fb189bfbd, type: 3}
    title: IntroCam3
    description: "ReachedIntroWayPointB()\r\n    \nCutSceneBoatNotifier"
  - thumbnail: {fileID: 2800000, guid: cae0698e827c1f749a92c01125908f44, type: 3}
    title: IntroCam3B
    description: 'IntroSequenceController triggers animation start on Male FigureHead


      MaleFigureHead
      animation triggers dialogue controller...



      The figurehead animation
      can have another event which triggers the next camera



'
  - thumbnail: {fileID: 2800000, guid: d2cbee0bd603a914cb6131bc9b907157, type: 3}
    title: 
    description: 
  - thumbnail: {fileID: 2800000, guid: 47690821e45cee646b702c45d61cda5b, type: 3}
    title: 
    description: 
  - thumbnail: {fileID: 0}
    title: 
