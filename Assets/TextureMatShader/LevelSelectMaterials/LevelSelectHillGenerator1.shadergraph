{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b227273083fa4a31849a29ad3be4835c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalculateHills (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1717.9998779296875,
            "y": -1261.0,
            "width": 231.0,
            "height": 142.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "73e1ab1134fd42d393fa991719284a24"
        },
        {
            "m_Id": "b6fe734ac9d04b05b76213484a25b56a"
        },
        {
            "m_Id": "18d7b25c1c64489fa1d2a71eb55467b0"
        },
        {
            "m_Id": "7818ce1b4aef452db33c6854258c66a7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "CalculateHills",
    "m_FunctionSource": "b19f0124a18db2e40b4b6a8c00d7cdc5",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// We define the array globally here so the function can access it \r\n// even though it's not a node input.\r\nuniform float4 _HillPositions[100];\r\n\r\nvoid CalculateHills_float(float3 WorldPos, float PointCount, float GlobalHeight, out float3 OffsetPos)\r\n{\r\n    OffsetPos = WorldPos;\r\n    int count = (int)PointCount;\r\n\r\n    for (int i = 0; i < count; i++)\r\n    {\r\n        float3 center = _HillPositions[i].xyz;\r\n        float radius = _HillPositions[i].w;\r\n        \r\n        // Calculate distance on the XZ plane\r\n        float d = distance(WorldPos.xz, center.xz);\r\n        \r\n        // Smoothstep falloff for a nice rounded hill shape\r\n        float h = 1.0 - saturate(d / radius);\r\n        float falloff = h * h * (3.0 - 2.0 * h);\r\n        \r\n        // Offset Y: center.y is the height of your handle object\r\n        OffsetPos.y += falloff * center.y * GlobalHeight;\r\n    }\r\n}"
}

